{
  "workspaces": [
    "service",
    "gateway",
    "apollo-gateway",
    "hive-gateway"
  ],
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:service\" \"npm run start:hive-gateway\"",
    "start:apollo": "npm run start:apollo-gateway",
    "start:gateway": "cd gateway && npm start",
    "start:apollo-gateway": "cd apollo-gateway && npm start",
    "start:hive-gateway": "cd hive-gateway && npm start",
    "start:service": "cd service && npm start"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
