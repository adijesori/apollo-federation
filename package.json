{
  "workspaces": [
    "service",
    "gateway",
    "apollo-gateway"
  ],
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:service\" \"npm run start:gateway\"",
    "start:apollo": "npm run start:apollo-gateway",
    "start:gateway": "cd gateway && npm start",
    "start:apollo-gateway": "cd apollo-gateway && npm start",
    "start:service": "cd service && npm start"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
